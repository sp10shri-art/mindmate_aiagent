# Copy to .env (make setup writes it for you). Never commit .env.

# --- Strands Decider 2B: where the decisions run --------------------------------------------
DECIDER_MODE=ugmdu                     # local | ugmdu | custom
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY= dcd_live_exObXcT7ZpIFVjdltRcjDhX8mflyb0Vp0Viys0Fref3tM9Qu                      # from the AWS User Group Madurai platform (ugmdu) or your endpoint
# local only: DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610 (or ...-hobson-v19)
# DECIDER_VISION=1                     # LOCAL decider only: load the vision tower (+0.7 GB; torch: mps/cuda/cpu).
#                                      # The hosted API (ugmdu) always reads images; no setting needed.

# --- The agent's LLM, always called through a Strands Agent -----------------------------------
LLM_PROVIDER=ugmdu                
BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0       # the agent
BEDROCK_SMALL_MODEL_ID=us.amazon.nova-micro-v1:0  # model routing: cheap tier
BEDROCK_MEDIUM_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_LARGE_MODEL_ID=us.amazon.nova-pro-v1:0    # model routing: strong tier
# BENCH_LLM_MODEL_ID=                             # the LLM baseline in make bench (defaults to the agent's model)
# LLM_PRICE_IN=0.8  LLM_PRICE_OUT=3.2             # USD per 1M tokens, for models the kit has no price for
AWS_REGION=ap-south-2
# AWS_PROFILE=default
# For make deploy when DECIDER_MODE=local (the deployed agent cannot reach your laptop):
# DEPLOY_DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
# DEPLOY_DECIDER_API_KEY=

DECIDER_MODE=ugmdu
DECIDER_URL=https://da25tnxy06gjk.cloudfront.net
DECIDER_API_KEY= dcd_live_exObXcT7ZpIFVjdltRcjDhX8mflyb0Vp0Viys0Fref3tM9Qu 
LLM_PROVIDER=ugmdu
BEDROCK_MODEL_ID=in.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=ap-south-2